---
import BaseInner from '../../../layouts/BaseInner.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const docs = await getCollection('genealogyDocs');
  return docs.map(doc => {
    const letter = doc.id.split('/')[0].toUpperCase();
    const personId = doc.data.id; // use data.id to preserve original case
    return {
      params: {
        lettersources: `${letter}sources`,
        id: `${personId}doc`,
      },
      props: { doc },
    };
  });
}

const { doc } = Astro.props;
const { title, displayTitle, intro, sections } = doc.data;
const headingTitle = displayTitle ?? title;
const letter = doc.id.split('/')[0].toUpperCase();
const imageBase = `${import.meta.env.BASE_URL}genealogy-images/${doc.id.split('/')[0]}`;
const backHref = `../${letter}families.htm#${doc.data.id}`;

function defaultHeading(type: string): string {
  const map: Record<string, string> = {
    census: 'Census Data',
    death: 'Death Data',
    birth: 'Birth Data',
    marriage: 'Marriage Data',
    military: 'Military Data',
    family: 'Family Data',
    notes: 'Notes',
    research: 'Research Opportunity',
  };
  return map[type] ?? type;
}

// Build an <img> tag; when `link` is set, wrap it in an anchor so the
// thumbnail clicks through to the full-size image in a new tab.
function imgHtml(img: { src: string; height?: number; link?: boolean }): string {
  const tag = `<img${img.height ? ` height="${img.height}"` : ''} src="${imageBase}/${img.src}">`;
  return img.link
    ? `<a href="${imageBase}/${img.src}" target="_blank" class="doc-image-zoom">${tag}</a>`
    : tag;
}
---

<BaseInner
  title={`Documentation - ${title}`}
  description={`Documentation for ${title}`}
  keywords={`Vining, ${title}, Vining family, genealogy`}
  activePage="Online Genealogy"
>

<p class="doc-back"><a href={backHref}>&larr; Back to {headingTitle}</a></p>

<center>
  <span class="doc-page-title">Documentation for {headingTitle}</span>
</center>

<br>

<div class="doc-page">

{intro && intro.map(item => (
  <div>
    {item.caption && <Fragment set:html={`${item.caption}<br>`} />}
    {item.images && (
      item.inline
        ? <div class="doc-image-block"><Fragment set:html={item.images.map(img =>
            imgHtml(img)
          ).join('&nbsp;&nbsp;&nbsp;')} /></div>
        : item.images.map(img => (
            <div class="doc-image-block"><Fragment set:html={imgHtml(img)} /></div>
          ))
    )}
  </div>
))}

{sections && sections.map(section => (
  <div>
    <p>
      {section.headingLarge
        ? <span class="doc-section-title">{section.heading ?? defaultHeading(section.type)}</span>
        : <b class="doc-section-title">{section.heading ?? defaultHeading(section.type)}</b>
      }
    </p>

    {section.type === 'census' && (
      <div>
        {section.table && (
          <table class="data-table">
            <tr>
              <th scope="col">&nbsp;</th>
              {section.table.columns.map(col => (
                <th scope="col" class="text-center">{col}</th>
              ))}
            </tr>
            {section.table.rows.map(row => (
              <tr>
                <td>
                  {row.indent ? <Fragment set:html={`&nbsp;&nbsp;&nbsp;&nbsp;${row.label}`} /> : row.label}
                </td>
                {row.values.map(val => (
                  <td class="text-center"><Fragment set:html={val.replace(/\n/g, '<br>')} /></td>
                ))}
              </tr>
            ))}
          </table>
        )}

        {section.entries && section.entries.map(entry => (
          <div class="doc-image-block">
            <b class="doc-year">{entry.year}</b>
            {entry.caption && <Fragment set:html={` ${entry.caption}:`} />}
            <br />
            {entry.images && (
              entry.inline
                ? <div class="doc-image-block"><Fragment set:html={entry.images.map(img =>
                    imgHtml(img)
                  ).join('&nbsp;&nbsp;&nbsp;')} /></div>
                : entry.images.map(img => (
                    <div class="doc-image-block"><Fragment set:html={imgHtml(img)} /></div>
                  ))
            )}
          </div>
        ))}
      </div>
    )}

    {section.type !== 'census' && section.items && section.items.map(item => (
      <div class="doc-image-block">
        {item.caption && <Fragment set:html={`${item.caption}<br>`} />}
        {item.images && (
          item.inline
            ? <div class="doc-image-block"><Fragment set:html={item.images.map(img =>
                imgHtml(img)
              ).join('&nbsp;&nbsp;&nbsp;')} /></div>
            : item.images.map(img => (
                <div class="doc-image-block"><Fragment set:html={imgHtml(img)} /></div>
              ))
        )}
      </div>
    ))}

    {(section.type === 'notes' || section.type === 'research') && section.text && (
      <Fragment set:html={section.text.replace(/\n/g, '<br>')} />
    )}

    {section.type === 'other' && section.text && (
      <Fragment set:html={section.text.replace(/\n/g, '<br>')} />
    )}

  </div>
))}

</div>

<p class="doc-back"><a href={backHref}>&larr; Back to {headingTitle}</a></p>

<div id="doc-lightbox" class="doc-lightbox" hidden>
  <button type="button" id="doc-lightbox-close" class="doc-lightbox-close" aria-label="Close">&times;</button>
  <img id="doc-lightbox-img" class="doc-lightbox-img" src="" alt="" />
</div>

<script>
  const box = document.getElementById('doc-lightbox');
  const boxImg = document.getElementById('doc-lightbox-img') as HTMLImageElement | null;

  function openBox(href: string) {
    if (!box || !boxImg) return;
    boxImg.src = href;
    box.hidden = false;
    document.body.style.overflow = 'hidden';
  }
  function closeBox() {
    if (!box || !boxImg) return;
    box.hidden = true;
    boxImg.src = '';
    document.body.style.overflow = '';
  }

  document.querySelectorAll('a.doc-image-zoom').forEach(link => {
    link.addEventListener('click', e => {
      const href = (link as HTMLAnchorElement).href;
      if (!href) return;
      e.preventDefault();
      openBox(href);
    });
  });

  // Close on the X button, on the backdrop (but not the image itself), or Escape.
  document.getElementById('doc-lightbox-close')?.addEventListener('click', closeBox);
  box?.addEventListener('click', e => {
    if (e.target !== boxImg) closeBox();
  });
  document.addEventListener('keydown', e => {
    if (e.key === 'Escape' && box && !box.hidden) closeBox();
  });
</script>

</BaseInner>
