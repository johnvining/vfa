---
import Base from '../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

const allNews = await getCollection('news');
allNews.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const renderedNews = await Promise.all(
  allNews.map(async (entry) => {
    const { Content } = await render(entry);
    return { entry, Content };
  })
);

const allGenealogy = await getCollection('genealogy');

type Link = string | { url: string; name?: string };
type GeneUpdate = {
  id: string;
  letter: string;
  name: string;
  what?: string;
  url?: Link | Link[];
  thanks?: string;
};

const geneByMonth = new Map<string, GeneUpdate[]>();

for (const entry of allGenealogy) {
  if (!entry.data.updates) continue;
  for (const update of entry.data.updates) {
    const monthKey = update.date.slice(0, 7);
    if (!geneByMonth.has(monthKey)) geneByMonth.set(monthKey, []);
    const surname = entry.data.head.surname ?? 'Vining';
    geneByMonth.get(monthKey)!.push({
      id: entry.data.id,
      letter: entry.data.letter.toUpperCase(),
      name: `${entry.data.head.givenName} ${surname}`,
      what: update.what,
      url: update.url,
      thanks: update.thanks,
    });
  }
}

function toUTCDate(dateStr: string): Date {
  const [y, m] = dateStr.split('-').map(Number);
  return new Date(Date.UTC(y, m - 1, 1));
}

function monthLabel(date: Date): string {
  return date.toLocaleString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
}

type NewsEvent = {
  type: 'news';
  date: Date;
  season: string;
  rendered: { entry: typeof allNews[0]; Content: any };
};
type GeneEvent = {
  type: 'gene';
  date: Date;
  monthKey: string;
  updates: GeneUpdate[];
};

const events: (NewsEvent | GeneEvent)[] = [
  ...renderedNews.map(r => ({
    type: 'news' as const,
    date: r.entry.data.date,
    season: r.entry.data.season,
    rendered: r,
  })),
  ...[...geneByMonth.entries()].map(([monthKey, updates]) => ({
    type: 'gene' as const,
    date: toUTCDate(monthKey),
    monthKey,
    updates,
  })),
];
events.sort((a, b) => b.date.getTime() - a.date.getTime());

type NewsItem = {
  kind: 'news';
  showSeasonHeader: boolean;
  season: string;
  showMonthHeader: boolean;
  month: string;
  Content: any;
};
type GeneGroup = { id: string; letter: string; name: string; whats: string[] };
type GeneItem = {
  kind: 'gene';
  showSeasonHeader: false;
  season: '';
  showMonthHeader: boolean;
  month: string;
  groups: GeneGroup[];
  thanks: string[];
};

// Combine multiple updates for the same headname within a month into one entry,
// preserving the order in which the first update for each headname appeared.
function groupUpdatesByEntry(updates: GeneUpdate[]): GeneGroup[] {
  const seen = new Map<string, number>();
  const out: GeneGroup[] = [];
  for (const u of updates) {
    const idx = seen.get(u.id);
    if (idx === undefined) {
      seen.set(u.id, out.length);
      out.push({ id: u.id, letter: u.letter, name: u.name, whats: u.what ? [u.what] : [] });
    } else if (u.what) {
      out[idx].whats.push(u.what);
    }
  }
  return out;
}
type RenderItem = NewsItem | GeneItem;

const renderItems: RenderItem[] = [];
let lastSeason = '';
let lastMonth = '';

for (const event of events) {
  const month = monthLabel(event.date);
  if (event.type === 'news') {
    const season = event.season;
    const showSeasonHeader = season !== lastSeason;
    const showMonthHeader = event.rendered.entry.data.showMonthHeading && month !== lastMonth;
    if (showSeasonHeader) lastSeason = season;
    if (month !== lastMonth) lastMonth = month;
    renderItems.push({ kind: 'news', showSeasonHeader, season, showMonthHeader, month, Content: event.rendered.Content });
  } else if (event.type === 'gene') {
    const showMonthHeader = month !== lastMonth;
    if (showMonthHeader) lastMonth = month;
    const thanks = [...new Set(event.updates.map(u => u.thanks).filter(Boolean) as string[])];
    const groups = groupUpdatesByEntry(event.updates);
    renderItems.push({ kind: 'gene', showSeasonHeader: false, season: '', showMonthHeader, month, groups, thanks });
  }
}
---

<Base
  title="Vining Newsletter Archive"
  description="Newsletter of the Vining Family Association."
  keywords="genealogy, Vining, Vining family, newsletter"
  activePage="News and Notes"
>

<p>Do you have any news to share about the Vining family? births, marriages, deaths? graduations? honors received? genealogical puzzles solved? Please send them along for inclusion in our News and Notes.</p>

{renderItems.map(item => (
  <Fragment>
    {item.showMonthHeader && <span class="news-month">{item.month}</span>}
    {item.kind === 'news' && <div class="news-entry"><item.Content /></div>}
    {item.kind === 'gene' && (
      <div class="gene-updates">
        <p>We've made the following updates to the online genealogy this month:</p>
        {item.groups.map(g => (
          <div class="gene-updates-entry">
            <a href={`Viningfamilies/${g.letter}families.htm#${g.id}`}>{g.name}</a>
            {g.whats.length === 0
              ? '.'
              : <Fragment set:html={` &#8212; ${g.whats.map(w => w.replace(/\.$/, '')).join('; ')}.`} />}
          </div>
        ))}
        {item.thanks.length > 0 && (
          <div class="gene-updates-thanks">Thanks to: {item.thanks.join(', ')}.</div>
        )}
      </div>
    )}
  </Fragment>
))}

</Base>
