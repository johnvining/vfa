---
import Base from '../layouts/Base.astro';
const years_with_pages = new Set([1660, 1670, 1680, 1690, 1700, 1790, 1800, 1810, 1820, 1830, 1840]);
const all_years = Array.from({length: 29}, (_, i) => 1660 + i * 10);
---

<Base
  title="Vining Family Association"
  description="A center for Vining research."
  keywords="genealogy, Vining, Vining family, Vining Family Association"
  activePage="Vining Migration"
>

<div class="letter-nav letter-nav-wrap">
  {all_years.map(y => (
    years_with_pages.has(y)
      ? <a href={`Viningmigration/Viningmigration${y}.htm`}>{y}</a>
      : <span class="letter-nav-unavailable">{y}</span>
  ))}
</div>

<hr class="nav-divider" />

<p>Click on a year to see which state Vinings were living in.</p>

</Base>
