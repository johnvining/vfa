---
interface Props {
  activePage?: string;
  baseUrl?: string;
}

const { activePage = '', baseUrl = '' } = Astro.props;

const navItems = [
  { label: 'Home', href: `${baseUrl}index.htm` },
  { label: 'Online Genealogy', href: `${baseUrl}Viningfamilieshome.htm` },
  { label: 'Research Problems', href: `${baseUrl}Viningresearchproblemshome.htm` },
  { label: 'News and Notes', href: `${baseUrl}Viningnewshome.htm` },
  { label: 'Census Records', href: `${baseUrl}Viningcensushome.htm` },
  { label: 'Vining Migration', href: `${baseUrl}Viningmigrationhome.htm` },
  { label: 'Places and People', href: `${baseUrl}Viningplacespeoplehome.htm` },
];
---

<header class="site-header">
   <img class="site-logo" height="140" src={`${import.meta.env.BASE_URL}Vining-Logo-Transparency.png`} alt="Vining Family Association logo">
   <div class="site-header-text">
      <div class="site-title">Vining Family Association</div>
      <div class="site-subtitle">One Name &#8212; Many Families</div>
      <a href="mailto:info@vining-family.org">info@vining-family.org</a>
   </div>
</header>

<hr class="nav-divider" />

<div class="main-nav">
  {navItems.map(item => (
    <span class="nav-item">
      {item.label === activePage
        ? <b>{item.label}</b>
        : <a href={item.href}>{item.label}</a>
      }
    </span>
  ))}
</div>

<hr class="nav-divider" />
