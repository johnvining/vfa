---
interface Props {
  activePage?: string;
}

const { activePage = '' } = Astro.props;

const navItems = [
  { label: 'Home', href: '/' },
  { label: 'Online Genealogy', href: '/Viningfamilieshome.htm' },
  { label: 'Research Problems', href: '/Viningresearchproblemshome.htm' },
  { label: 'News and Notes', href: '/Viningnewshome.htm' },
  { label: 'Census Records', href: '/Viningcensushome.htm' },
  { label: 'Vining Migration', href: '/Viningmigrationhome.htm' },
  { label: 'Places and People', href: '/Viningplacespeoplehome.htm' },
];
---

<header class="site-header">
   <img class="site-logo" height="140" src={`${import.meta.env.BASE_URL}Vining-Logo-Transparency.png`} alt="Vining Family Association logo">
   <div class="site-header-text">
      <div class="site-title">Vining Family Association</div>
      <div class="site-subtitle">One Name &#8212; Many Families</div>
      <a href="mailto:info@vining-family.org">info@vining-family.org</a>
   </div>
</header>

<hr class="nav-divider" />

<div class="main-nav">
  {navItems.map(item => (
    <span class="nav-item">
      <a href={item.href} aria-current={item.label === activePage ? 'page' : undefined}>{item.label}</a>
    </span>
  ))}
</div>

<hr class="nav-divider" />
